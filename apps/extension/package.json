{
  "name": "@prep-sheet/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build --mode development",
    "build:edge": "wxt build -b edge --mode development",
    "build:production": "wxt build --mode production",
    "check-types": "wxt prepare && tsc --noEmit",
    "package": "wxt zip --mode development && wxt zip -b edge --mode development",
    "package:production": "wxt zip --mode production && wxt zip -b edge --mode production",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@prep-sheet/auth": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@prep-sheet/api": "workspace:*",
    "@prep-sheet/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.2",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "wxt": "^0.21.4"
  }
}
