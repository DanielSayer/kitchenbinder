DATABASE_URL=postgresql://postgres:password@localhost:5432/prep-sheet
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
# Optional on localhost; required when deploying extension support.
# Comma-separated Chrome/Edge store IDs, with no wildcard or callback URLs.
EXTENSION_IDS=
# Discord Developer Portal > OAuth2 > Redirects:
# http://localhost:3001/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Google Cloud Console > OAuth client > Web application > Authorized redirect URIs:
# http://localhost:3001/api/auth/callback/google
# Add the equivalent HTTPS callback for your production domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
# Set true with a key to enable imports. Production always requires this choice.
AI_ENABLED=false
# Only the reviewed model in packages/env/src/ai-policy.ts may be enabled.
OPENAI_MODEL=gpt-5.6-luna

# Polar sandbox first. Use separate production credentials and product ID at launch.
# Production requires disabled, sandbox or production; enabled mode must match POLAR_SERVER.
BILLING_MODE=disabled
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_PRO_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
# Run pnpm providers:check against the intended deployment environment.
# Complete docs/provider-acceptance.md before exposing enabled features.
