# Copy to /etc/prep-sheet/runtime.env with mode 0600, outside the checkout.
# Compose dotenv format, NOT a shell script. Single-quote values containing $.
# URL-encode database username/password components.
PREP_SHEET_IMAGE=REGISTRY/OWNER/prep-sheet@sha256:RELEASE_DIGEST
DATABASE_URL='postgresql://prep_sheet_runtime:URL_ENCODED_PASSWORD@DIRECT_ENDPOINT.neon.tech/PREP_DATABASE?sslmode=verify-full&connect_timeout=10'
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
BETTER_AUTH_SECRET='REPLACE_WITH_INDEPENDENT_RANDOM_SESSION_SECRET'
WEB_PROXY_SECRET='REPLACE_WITH_INDEPENDENT_RANDOM_PROXY_SECRET'
BETTER_AUTH_URL=https://kitchenbinder.app
SUPPORT_EMAIL=MONITORED_MAILBOX
SUPPORT_OPERATOR='NAMED_OPERATOR_AND_COVER'
GOOGLE_CLIENT_ID=REPLACE_WITH_ACTUAL_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET='REPLACE_WITH_ACTUAL_GOOGLE_CLIENT_SECRET'
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
AI_ENABLED=false
BILLING_MODE=disabled
EXTENSION_IDS=
# Initial values for a 4 GiB / 2 vCPU Linux host, subject to load acceptance.
WEB_CPUS=1.5
WEB_MEMORY_LIMIT=1536m
WEB_MEMORY_RESERVATION=768m
WORKER_CPUS=0.75
WORKER_MEMORY_LIMIT=768m
WORKER_MEMORY_RESERVATION=256m
MONITOR_CPUS=0.25
MONITOR_MEMORY_LIMIT=192m
MONITOR_MEMORY_RESERVATION=64m
# Enable monitoring after configuring and accepting the actual receiver.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_TOKEN=
