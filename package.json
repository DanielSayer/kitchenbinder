{
  "name": "prep-sheet",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "providers:check": "node --env-file-if-exists=apps/web/.env scripts/check-providers.mjs",
    "test": "node scripts/test.mjs",
    "test:live": "node scripts/test.mjs packages/api/src/recipes/live.test.ts",
    "test:production": "node scripts/test.mjs packages/api/src/recipes/production-server.test.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "tsc --noEmit && turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:extension": "turbo run dev -F @prep-sheet/extension --ui=stream",
    "build:extension": "turbo run build -F @prep-sheet/extension --ui=stream",
    "package:extension": "turbo run package -F @prep-sheet/extension --ui=stream",
    "db:push": "turbo run db:push -F @prep-sheet/db --",
    "db:studio": "turbo run db:studio -F @prep-sheet/db --",
    "db:generate": "turbo run db:generate -F @prep-sheet/db --",
    "db:migrate": "node packages/db/scripts/migrate.mjs",
    "db:start": "turbo run db:start -F @prep-sheet/db --",
    "db:watch": "turbo run db:watch -F @prep-sheet/db --",
    "db:stop": "turbo run db:stop -F @prep-sheet/db --",
    "db:down": "turbo run db:down -F @prep-sheet/db --",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "worker:imports": "node --env-file-if-exists=apps/web/.env --import tsx packages/api/src/import-worker.ts",
    "start": "node scripts/start-web.mjs",
    "start:worker": "node scripts/start-worker.mjs",
    "build:release": "pnpm --filter web build",
    "db:verify": "node packages/db/scripts/migrate.mjs --verify",
    "db:adopt": "node packages/db/scripts/migrate.mjs --adopt"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@prep-sheet/config": "workspace:*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
