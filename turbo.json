{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "apps/web/src/styles/brand.css",
    "apps/web/public/branding/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["WXT_PREP_SHEET_ORIGIN", "WXT_EXTENSION_PUBLIC_KEY"]
    },
    "package": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**"],
      "env": ["WXT_PREP_SHEET_ORIGIN", "WXT_EXTENSION_PUBLIC_KEY"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "cache": false,
      "dependsOn": ["^check-types"],
      "env": ["WXT_PREP_SHEET_ORIGIN", "WXT_EXTENSION_PUBLIC_KEY"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["WXT_PREP_SHEET_ORIGIN", "WXT_EXTENSION_PUBLIC_KEY"]
    },
    "web#dev": {
      "with": ["@prep-sheet/api#dev"],
      "cache": false,
      "persistent": true,
      "env": ["WXT_PREP_SHEET_ORIGIN", "WXT_EXTENSION_PUBLIC_KEY"]
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:start": {
      "cache": false
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "persistent": true
    },
    "db:down": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_POOL_MAX",
    "DATABASE_CONNECT_TIMEOUT_MS",
    "DATABASE_IDLE_TIMEOUT_MS",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "SUPPORT_EMAIL",
    "SUPPORT_OPERATOR",
    "EXTENSION_IDS",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "POLAR_ACCESS_TOKEN",
    "POLAR_WEBHOOK_SECRET",
    "POLAR_PRO_PRODUCT_ID",
    "POLAR_SERVER",
    "NODE_ENV",
    "HOST",
    "PORT",
    "SHUTDOWN_TIMEOUT_MS",
    "WEB_PROXY_SECRET",
    "WORKER_SHUTDOWN_TIMEOUT_MS",
    "PREP_SHEET_RELEASE_IMAGE",
    "SKIP_ENV_VALIDATION"
  ]
}
