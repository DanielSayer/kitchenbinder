{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "apps/web/src/styles/brand.css",
    "apps/web/public/branding/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["WXT_PREP_SHEET_ORIGIN", "WXT_EXTENSION_PUBLIC_KEY"]
    },
    "package": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**"],
      "env": ["WXT_PREP_SHEET_ORIGIN", "WXT_EXTENSION_PUBLIC_KEY"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "env": ["WXT_PREP_SHEET_ORIGIN", "WXT_EXTENSION_PUBLIC_KEY"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["WXT_PREP_SHEET_ORIGIN", "WXT_EXTENSION_PUBLIC_KEY"]
    },
    "web#dev": {
      "with": ["@prep-sheet/api#dev"],
      "cache": false,
      "persistent": true,
      "env": ["WXT_PREP_SHEET_ORIGIN", "WXT_EXTENSION_PUBLIC_KEY"]
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:start": {
      "cache": false
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "persistent": true
    },
    "db:down": {
      "cache": false
    }
  }
}
